@page "/trainees/{ProfileId}"
@attribute [Authorize(Roles = "Admin")]
@inject TraineeApiClient TraineeApi
@inject NavigationManager Nav

<PageTitle>Trainee Profile</PageTitle>

<MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
           Variant="Variant.Text"
           Class="mb-3"
           OnClick="@(() => Nav.NavigateTo("/trainees"))">
    Back to trainees
</MudButton>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_profile is null)
{
    <MudAlert Severity="Severity.Warning">Trainee profile not found.</MudAlert>
}
else
{
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack AlignItems="AlignItems.Center" Spacing="2">
                    @if (!string.IsNullOrWhiteSpace(_profile.ProfilePhotoUrl))
                    {
                        <MudAvatar Size="Size.Large" Style="width: 120px; height: 120px;">
                            <MudImage Src="@_profile.ProfilePhotoUrl" />
                        </MudAvatar>
                    }
                    else
                    {
                        <MudAvatar Color="Color.Info" Size="Size.Large" Style="width: 120px; height: 120px;">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large" />
                        </MudAvatar>
                    }
                    <MudText Typo="Typo.h6" Align="Align.Center">Trainee @_profile.UserId</MudText>
                    <MudDivider Class="my-2" />
                    <MudSimpleTable Dense="true" Bordered="false" Striped="false" Style="width:100%; background: transparent;">
                        <tbody>
                            <tr>
                                <td><strong>Gender</strong></td>
                                <td>@_profile.Gender</td>
                            </tr>
                            <tr>
                                <td><strong>Date of Birth</strong></td>
                                <td>@_profile.DateOfBirth.ToString("yyyy-MM-dd")</td>
                            </tr>
                            <tr>
                                <td><strong>Weight</strong></td>
                                <td>@_profile.WeightKg kg</td>
                            </tr>
                            <tr>
                                <td><strong>Height</strong></td>
                                <td>@_profile.HeightCm cm</td>
                            </tr>
                            <tr>
                                <td><strong>Fitness Level</strong></td>
                                <td>@_profile.FitnessLevel</td>
                            </tr>
                            <tr>
                                <td><strong>Created</strong></td>
                                <td>@_profile.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle2" Class="mb-1">Goals</MudText>
                <MudText Typo="Typo.body2">@_profile.Goals</MudText>

                @if (!string.IsNullOrWhiteSpace(_profile.MedicalNotes))
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Medical Notes</MudText>
                    <MudAlert Severity="Severity.Warning" Dense="true">@_profile.MedicalNotes</MudAlert>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public string ProfileId { get; set; } = string.Empty;

    private bool _loading = true;
    private string? _error;
    private CoachingFit.User.Shared.DTOs.Responses.TraineeProfileResponse? _profile;

    protected override async Task OnInitializedAsync()
    {
        if (!Guid.TryParse(ProfileId, out var id))
        {
            _error = "Invalid profile ID.";
            _loading = false;
            return;
        }

        try
        {
            _profile = await TraineeApi.GetByIdAsync(id);
        }
        catch (HttpRequestException ex)
        {
            _error = $"Cannot reach the backend: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}
