@page "/coaches"
@attribute [Authorize(Roles = "Admin")]
@inject CoachApiClient CoachApi
@inject NavigationManager Nav

<PageTitle>All Coaches</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">All Coaches</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else
{
    <MudTable Items="_coaches" Dense="true" Hover="true" Bordered="false"
              Filter="@(c => FilterCoach(c, _search))">
        <ToolBarContent>
            <MudTextField @bind-Value="_search"
                          Placeholder="Search by name, email, or gender..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Class="mt-0" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Photo</MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Gender</MudTh>
            <MudTh>Experience</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Created</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                @if (!string.IsNullOrWhiteSpace(context.ProfilePhotoUrl))
                {
                    <MudAvatar Size="Size.Small">
                        <MudImage Src="@context.ProfilePhotoUrl" />
                    </MudAvatar>
                }
                else
                {
                    <MudAvatar Color="Color.Secondary" Size="Size.Small">
                        <MudIcon Icon="@Icons.Material.Filled.Person" />
                    </MudAvatar>
                }
            </MudTd>
            <MudTd>@(_userInfo.TryGetValue(context.UserId, out var info) ? info.FullName : "—")</MudTd>
            <MudTd>@(_userInfo.TryGetValue(context.UserId, out var emailInfo) ? emailInfo.Email : "—")</MudTd>
            <MudTd>@context.Gender</MudTd>
            <MudTd>@context.ExperienceYears yrs</MudTd>
            <MudTd>
                @{
                    _userInfo.TryGetValue(context.UserId, out var statusInfo);
                    var (label, color) = StatusFor(statusInfo);
                }
                <MudChip T="string"
                         Color="@color"
                         Variant="Variant.Filled"
                         Size="Size.Small">
                    @label
                </MudChip>
            </MudTd>
            <MudTd>@context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</MudTd>
            <MudTd>
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           OnClick="@(() => Nav.NavigateTo($"/coaches/{context.UserId}"))">
                    Review
                </MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No coaches registered yet.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private bool _loading = true;
    private string? _error;
    private string _search = string.Empty;
    private List<CoachingFit.User.Shared.DTOs.Responses.CoachProfileResponse> _coaches = new();
    private Dictionary<string, CoachingFit.Identity.Shared.DTOs.Responses.CoachUserSummary> _userInfo = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profilesTask = CoachApi.GetAllProfilesAsync();
            var detailsTask = CoachApi.GetCoachDetailsAsync();
            await Task.WhenAll(profilesTask, detailsTask);

            _coaches = (await profilesTask).ToList();
            _userInfo = (await detailsTask).ToDictionary(d => d.UserId);
        }
        catch (HttpRequestException ex)
        {
            _error = $"Cannot reach the backend: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private bool FilterCoach(
        CoachingFit.User.Shared.DTOs.Responses.CoachProfileResponse c, string search)
    {
        if (string.IsNullOrWhiteSpace(search)) return true;
        var info = _userInfo.GetValueOrDefault(c.UserId);
        return c.Gender.Contains(search, StringComparison.OrdinalIgnoreCase)
            || (info?.FullName.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (info?.Email.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private static (string Label, Color Color) StatusFor(
        CoachingFit.Identity.Shared.DTOs.Responses.CoachUserSummary? info)
    {
        if (info is null) return ("—", Color.Default);
        if (info.IsActive) return ("Active", Color.Success);
        if (info.RejectionReason is not null) return ("Rejected", Color.Error);
        return ("Pending", Color.Warning);
    }
}
