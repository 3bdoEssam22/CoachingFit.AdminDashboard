@page "/trainees"
@attribute [Authorize(Roles = "Admin")]
@inject TraineeApiClient TraineeApi
@inject NavigationManager Nav

<PageTitle>Trainees</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Trainees</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else
{
    <MudTable Items="_trainees" Dense="true" Hover="true" Bordered="false"
              Filter="@(t => FilterTrainee(t, _search))">
        <ToolBarContent>
            <MudTextField @bind-Value="_search"
                          Placeholder="Search by name, email, or gender..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Class="mt-0" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Photo</MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Gender</MudTh>
            <MudTh>Fitness Level</MudTh>
            <MudTh>Created</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                @if (!string.IsNullOrWhiteSpace(context.ProfilePhotoUrl))
                {
                    <MudAvatar Size="Size.Small">
                        <MudImage Src="@context.ProfilePhotoUrl" />
                    </MudAvatar>
                }
                else
                {
                    <MudAvatar Color="Color.Info" Size="Size.Small">
                        <MudIcon Icon="@Icons.Material.Filled.Person" />
                    </MudAvatar>
                }
            </MudTd>
            <MudTd>@(_userInfo.TryGetValue(context.UserId, out var info) ? info.FullName : "—")</MudTd>
            <MudTd>@(_userInfo.TryGetValue(context.UserId, out var emailInfo) ? emailInfo.Email : "—")</MudTd>
            <MudTd>@context.Gender</MudTd>
            <MudTd>@context.FitnessLevel</MudTd>
            <MudTd>@context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</MudTd>
            <MudTd>
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           OnClick="@(() => Nav.NavigateTo($"/trainees/{context.Id}"))">
                    View
                </MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No trainees registered yet.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private bool _loading = true;
    private string? _error;
    private string _search = string.Empty;
    private List<CoachingFit.User.Shared.DTOs.Responses.TraineeProfileResponse> _trainees = new();
    private Dictionary<string, CoachingFit.Identity.Shared.DTOs.Responses.TraineeUserSummary> _userInfo = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profilesTask = TraineeApi.GetAllProfilesAsync();
            var detailsTask = TraineeApi.GetTraineeDetailsAsync();
            await Task.WhenAll(profilesTask, detailsTask);

            _trainees = (await profilesTask).ToList();
            _userInfo = (await detailsTask).ToDictionary(d => d.UserId);
        }
        catch (HttpRequestException ex)
        {
            _error = $"Cannot reach the backend: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private bool FilterTrainee(
        CoachingFit.User.Shared.DTOs.Responses.TraineeProfileResponse t, string search)
    {
        if (string.IsNullOrWhiteSpace(search)) return true;
        var info = _userInfo.GetValueOrDefault(t.UserId);
        return t.Gender.Contains(search, StringComparison.OrdinalIgnoreCase)
            || (info?.FullName.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (info?.Email.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false);
    }
}
